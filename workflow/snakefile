# ==============================================================================
# snakefile 
# orchestrates the main pipeline and calls assembly.smk and annotation.smk by demand.
# ==============================================================================

import os
import pandas as pd

configfile: "config.yaml"

# path do arquivo de samples pode ser sobrescrito por variável de ambiente
# (usado pelo smoke test: GENOMASLBCM_SAMPLES=samples_test.tsv)
SAMPLES_FILE = os.environ.get("GENOMASLBCM_SAMPLES", "samples.tsv")
samples_df = pd.read_csv(SAMPLES_FILE, sep="\t").set_index("sample", drop=False)
# saves all sample names in /raw_data into SAMPLES
SAMPLES = samples_df["sample"].tolist()

# uses list comprehension to generate the busco outputs based on the values determined in samples.tsv
BUSCO_OUTPUTS = [
    f"results/qc_reports/busco/{sample}/short_summary.specific.{samples_df.loc[sample, 'busco_lineage']}.{sample}.txt" 
    for sample in SAMPLES
]


### RULES ###
# this allows you to choose the "run mode". 
# to simply run the QC and see the quality of the data, run "snakemake qc_only --cores all"
# if you want to assemble the genome first (without annotating) run "snakemake assemble --cores all". This automatically includes QC.
# if you already have the assembled genomes and now want to annotate, run "snakemake annotate" 
# if you wish to assemble and annotate, simply run "snakemake --cores all"

# assembly + annotation
rule all:
    input:
        # assembly
        "results/qc_reports/multiqc/multiqc_report.html",
        expand("results/qc_reports/{sample}_assembly_summary.txt", sample=SAMPLES),
        "run_history/run_latest.stamp",
        expand("results/02_assembly/{sample}/.cleaned", sample=SAMPLES),
        # annotation
        expand("results/03_annotation/{sample}/placeholder.txt", sample=SAMPLES),
        # html report
        "results/full_report.html"


# QC only
rule qc_only:
    input:
        expand("results/qc_reports/fastp/{sample}_fastp.html", sample=SAMPLES),
        expand("results/qc_reports/fastp/{sample}_fastp.json", sample=SAMPLES)


# QC and assembly only
rule assemble:
    input:
        "results/qc_reports/multiqc/multiqc_report.html",
        expand("results/qc_reports/{sample}_assembly_summary.txt", sample=SAMPLES),
        "run_history/run_latest.stamp",
        expand("results/02_assembly/{sample}/.cleaned", sample=SAMPLES),
        # html report
        "results/full_report.html"


# annotation (requires assembly)
rule annotate:
    input:
        expand("results/03_annotation/{sample}/placeholder.txt", sample=SAMPLES)


# phylogenomics (requires assembly)
rule phylogenomics:
    input:
        expand("results/04_phylogenomics/{sample}/placeholder.txt", sample=SAMPLES)


# MODULES 
# those files contain the rules for each module of the pipeline
include: "rules/assembly.smk"
include: "rules/annotation.smk"

# smoke test: roda pipeline em dataset minúsculo (~100k read pairs)
# uso (do root do projeto):
#   GENOMASLBCM_SAMPLES=samples_test.tsv \
#   snakemake -s workflow/snakefile smoke --cores 4 --use-apptainer
# verifica: fastp, spades, filter, pypolca, quast, busco, kraken2, custom_report, cleanup
# não inclui: multiqc, compile_run_history (testar separadamente)
rule smoke:
    input:
        expand("results/qc_reports/{sample}_assembly_summary.txt", sample=SAMPLES),
        expand("results/02_assembly/{sample}/.cleaned", sample=SAMPLES),
